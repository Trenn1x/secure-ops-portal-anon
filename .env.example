# Required: generate a persistent random secret and store it securely.
APP_SECRET=
# Maximum session age from sign-in, in whole hours (1–24).
APP_SESSION_HOURS=12
# Optional five-minute limit per address seen by the app. 0 disables it.
APP_LOGIN_SOURCE_LIMIT=0
# Optional: when set, this takes precedence over DATABASE_PATH
# Example: postgresql://user:password@host:5432/ops_portal
DATABASE_URL=
DATABASE_PATH=/data/ops_portal.db
PORT=8000
CHECKIN_ALERT_MINUTES=60
CHECKIN_LATE_SYNC_MINUTES=5
